{
  "name": "hicanvas",
  "version": "0.0.50",
  "private": true,
  "description": "Standalone canvas based on Cowart. Conversation isolation, custom image providers and MCP.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm test && node tools/check-styles.mjs && npm run design:lint && node tools/generate-tokens.mjs --check && npm run build && node tools/check-build.mjs && npm run desktop:bundle && node tools/check.mjs",
    "check:staged": "node tools/check.mjs --staged && npm test && node tools/check-styles.mjs --staged",
    "dev": "vite --host 127.0.0.1",
    "build": "node tools/build.mjs",
    "start": "vite preview --host 127.0.0.1",
    "mcp": "node bin/hicanvas-mcp.mjs",
    "test": "node tools/check.mjs && node tools/run-tests.mjs",
    "perf:baseline": "node tools/perf-baseline.mjs",
    "renderer:preview": "node tools/renderer-preview.mjs",
    "renderer:check": "node tools/check-renderer-boundary.mjs",
    "renderer:smoke": "node tools/renderer-smoke.mjs",
    "design:lint": "design.md lint DESIGN.md",
    "design:tokens": "node tools/generate-tokens.mjs",
    "desktop:bundle": "node tools/pack-desktop.mjs --bundle-only",
    "desktop:pack": "npm run build && swift desktop/create-icon.swift build/hiCanvas.iconset && iconutil -c icns build/hiCanvas.iconset -o build/hiCanvas.icns && node tools/pack-desktop.mjs && npm run desktop:smoke",
    "desktop:smoke": "node tools/smoke-desktop.mjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@electron/packager": "20.3.0",
    "@google/design.md": "0.4.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tiptap/pm": "3.27.0",
    "@tldraw/assets": "^5.1.1",
    "@tldraw/store": "5.1.1",
    "@tldraw/tlschema": "5.1.1",
    "@tldraw/utils": "5.1.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "42.5.0",
    "esbuild": "^0.27.0",
    "fractional-indexing": "^3.2.0",
    "html2canvas": "1.4.1",
    "lucide-react": "^1.24.0",
    "mediabunny": "^1.61.0",
    "postcss": "8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "^5.1.1",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  }
}
